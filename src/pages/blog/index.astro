---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Gone Coding Blog",
  "url": "https://gone-coding.com/blog",
  "description": "Thoughts on security, developer tools, SSL/TLS, and building software by the team at Gone Coding Ltd.",
  "publisher": {
    "@type": "Organization",
    "name": "Gone Coding Ltd.",
    "url": "https://gone-coding.com"
  },
  "blogPost": posts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "url": `https://gone-coding.com/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`,
  }))
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Layout
  title="Blog"
  description="Articles on SSL certificate management, TLS security, developer tooling, and software engineering by Gone Coding Ltd."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-4xl px-6 pt-20 pb-16">
    <h1 class="font-display uppercase leading-[0.95] tracking-wide text-[clamp(3rem,8vw,5.5rem)]">
      Writing<span class="neon">.</span>
    </h1>
    <p class="mt-6 max-w-lg leading-relaxed text-muted-foreground">
      Notes from the workshop: certificates, TLS, developer tooling, and what
      we learn shipping our own products.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-24">
    <div class="border-t border-border/60">
      {posts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <a href={`/blog/${slug}/`} class="row-link group block border-b border-border/60 px-2 py-8 sm:px-4" aria-label={post.data.title}>
            <time datetime={post.data.pubDate.toISOString()} class="font-mono text-[13px] text-muted-foreground">
              {formatDate(post.data.pubDate)}
            </time>
            <h2 class="mt-2 text-xl font-semibold tracking-tight group-hover:text-primary transition-colors sm:text-2xl">
              {post.data.title}
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
              {post.data.description}
            </p>
            {post.data.tags.length > 0 && (
              <p class="mt-3 font-mono text-xs text-muted-foreground/80">
                {post.data.tags.join(', ')}
              </p>
            )}
          </a>
        );
      })}
    </div>
  </section>
</Layout>
