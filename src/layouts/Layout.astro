---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  article?: boolean;
  publishDate?: Date;
  modifiedDate?: Date;
}

const {
  title = 'Gone Coding',
  description = 'Gone Coding Ltd. is a software engineering company based in Hong Kong. We build developer tools and web infrastructure products including SSLBoard, QCReady, and more.',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = new URL('/og-default.svg', Astro.site).href,
  article = false,
  publishDate,
  modifiedDate,
} = Astro.props;

const year = new Date().getFullYear();
const siteName = 'Gone Coding';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}

    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        var d = t === "dark" || ((!t || t === "auto") && matchMedia("(prefers-color-scheme:dark)").matches);
        document.documentElement.classList.toggle("dark", d);
      })();
    </script>
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="48AKMjWS0KdYxMMXoUWzMw" async></script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased">
    <header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/80 backdrop-blur-lg">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-6">
        <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-80" aria-label="Gone Coding, Home">
          <svg viewBox="0 0 32 32" fill="none" class="size-6 text-primary" aria-hidden="true">
            <path d="M19 6h-4a8 8 0 0 0 0 16h4" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <path d="M22 26h-2a8 8 0 0 1 0-16h2" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <span class="font-mono text-[13px] tracking-tight text-foreground">gone-coding.com</span>
        </a>
        <nav class="flex items-center gap-1" aria-label="Main navigation">
          <a href="/#products" class="hidden h-9 items-center rounded-md px-3 font-mono text-[13px] text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground sm:inline-flex">
            Products
          </a>
          <a href="/#writing" class="hidden h-9 items-center rounded-md px-3 font-mono text-[13px] text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground sm:inline-flex">
            Writing
          </a>
          <a href="/blog/" class="inline-flex h-9 items-center rounded-md px-3 font-mono text-[13px] text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
            Blog
          </a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border/60">
      <div class="mx-auto max-w-6xl px-6 py-14">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          <div class="space-y-3">
            <div class="flex items-center gap-2.5">
              <svg viewBox="0 0 32 32" fill="none" class="size-5 text-primary" aria-hidden="true">
                <path d="M19 6h-4a8 8 0 0 0 0 16h4" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                <path d="M22 26h-2a8 8 0 0 1 0-16h2" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              </svg>
              <span class="font-semibold tracking-tight">Gone Coding Ltd.</span>
            </div>
            <p class="max-w-xs text-sm leading-relaxed text-muted-foreground">
              Ships software from Hong Kong. Mostly tools that keep an eye on the web.
            </p>
          </div>
          <div>
            <address class="font-mono text-[13px] not-italic leading-relaxed text-muted-foreground">
              Unit 1603, The L. Plaza<br />
              367–375 Queen's Road Central<br />
              Sheung Wan, Hong Kong<br />
              <a href="mailto:chris@gone-coding.com" class="mt-2 inline-block text-foreground underline decoration-primary/60 underline-offset-4 transition-colors hover:decoration-primary">
                chris@gone-coding.com
              </a>
            </address>
          </div>
          <nav class="flex flex-col gap-2 font-mono text-[13px] text-muted-foreground sm:items-start lg:items-end" aria-label="Footer navigation">
            <a href="/#products" class="transition-colors hover:text-foreground">Products</a>
            <a href="/blog/" class="transition-colors hover:text-foreground">Blog</a>
            <a href="/terms-conditions/" class="transition-colors hover:text-foreground">Terms</a>
            <a href="/privacy-policy/" class="transition-colors hover:text-foreground">Privacy</a>
          </nav>
        </div>
        <div class="mt-12 flex flex-col gap-2 border-t border-border/60 pt-6 font-mono text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
          <p>&copy; {year} Gone Coding Ltd.</p>
          <p aria-hidden="true">22.3193° N, 114.1694° E</p>
        </div>
      </div>
    </footer>
  </body>
</html>
